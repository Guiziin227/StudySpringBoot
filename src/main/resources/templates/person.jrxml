	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="StudySchema"/>
	<parameter name="PERSON_ID" class="java.lang.Long"/>
	<query language="SQL"><![CDATA[SELECT id,
	CONCAT(first_name,' ',last_name) as name,
	address,
	gender,
	enabled,
	wikipedia_profile_url as profileUrl,
	photo_url as photoUrl
FROM study_schema.person
WHERE 
	id = $P{PERSON_ID}
]]></query>
